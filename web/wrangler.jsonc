{
  "name": "aria-web",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "ratelimits": [
    { "name": "SEARCH_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "AUDIO_LIMIT", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
